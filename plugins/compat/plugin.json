{
  "apiVersion": "glade.plugin.v1",
  "name": "compat",
  "version": "0.1.0",
  "summary": "Maintainer support tools, fixtures, surface ledgers, and parity scanners.",
  "commands": [
    {
      "path": [
        "compat"
      ],
      "summary": "Run compatibility fixture and report commands."
    },
    {
      "path": [
        "compat",
        "lwc"
      ],
      "summary": "Capture LWC shell evidence and native API parity."
    },
    {
      "path": [
        "compat",
        "lwc",
        "capture"
      ],
      "summary": "Write LWC target, browser, and support evidence."
    },
    {
      "path": [
        "compat",
        "lwc",
        "corpus"
      ],
      "summary": "Scan package-first LWC corpus support gaps."
    },
    {
      "path": [
        "compat",
        "lwc",
        "parity"
      ],
      "summary": "Generate the Native LWC API parity ledger."
    },
    {
      "path": [
        "surface"
      ],
      "summary": "Refresh and inspect the Salesforce surface ledger."
    },
    {
      "path": [
        "corpus"
      ],
      "summary": "Run Glade over public corpora and classify diagnostics."
    },
    {
      "path": [
        "matrix"
      ],
      "summary": "Print the full capability matrix."
    },
    {
      "path": [
        "mvp"
      ],
      "summary": "Print MVP readiness status."
    },
    {
      "path": [
        "local-tests"
      ],
      "summary": "Report local Apex test execution readiness."
    },
    {
      "path": [
        "post-parity"
      ],
      "summary": "Scan a project for unsupported surfaces."
    },
    {
      "path": [
        "examples"
      ],
      "summary": "Scan example projects and report support status."
    },
    {
      "path": [
        "replay"
      ],
      "summary": "Replay checked run bundles."
    },
    {
      "path": [
        "ui-controllers"
      ],
      "summary": "Discover Visualforce controller surfaces."
    },
    {
      "path": [
        "server-examples"
      ],
      "summary": "Probe checked server route examples."
    },
    {
      "path": [
        "visualforce"
      ],
      "summary": "Capture and score Visualforce rendering evidence."
    },
    {
      "path": [
        "dashboard"
      ],
      "summary": "Generate compatibility dashboard output."
    },
    {
      "path": [
        "gaps"
      ],
      "summary": "Generate known-gaps output."
    },
    {
      "path": [
        "stdlib"
      ],
      "summary": "Generate standard-library coverage output."
    },
    {
      "path": [
        "docs-inventory"
      ],
      "summary": "Inventory Salesforce docs."
    },
    {
      "path": [
        "catalog"
      ],
      "summary": "Build a capability catalog."
    },
    {
      "path": [
        "reconcile"
      ],
      "summary": "Reconcile docs inventory with the catalog."
    },
    {
      "path": [
        "doc-contracts"
      ],
      "summary": "Report Salesforce docs behavior contracts."
    },
    {
      "path": [
        "salesforce-coverage"
      ],
      "summary": "Generate Salesforce coverage manifests."
    },
    {
      "path": [
        "standard-objects"
      ],
      "summary": "Report generated standard object coverage."
    },
    {
      "path": [
        "stub-contracts"
      ],
      "summary": "Report generated stub behavioral contract policy."
    },
    {
      "path": [
        "stub-behavior"
      ],
      "summary": "Report generated platform stub behavior status."
    },
    {
      "path": [
        "stub-inventory"
      ],
      "summary": "Compare stub source with generated shapes."
    },
    {
      "path": [
        "product-namespaces"
      ],
      "summary": "Report product namespace coverage."
    },
    {
      "path": [
        "tooling-fixtures"
      ],
      "summary": "Summarize tooling fixture reports."
    },
    {
      "path": [
        "evidence"
      ],
      "summary": "Compare fixture evidence with a catalog."
    },
    {
      "path": [
        "oracle-stdlib"
      ],
      "summary": "Run scratch-org standard-library oracle probes."
    }
  ],
  "editor": {
    "actions": [
      {
        "id": "compat.postParity",
        "title": "Scan Unsupported Local Surfaces",
        "view": "runs",
        "contexts": [
          "project"
        ],
        "command": [
          "post-parity"
        ],
        "args": [
          "--project",
          "${projectRoot}",
          "--json",
          "--editor-findings"
        ],
        "output": "glade.findings.v1",
        "icon": "search"
      },
      {
        "id": "compat.visualforceLocalCapture",
        "title": "Capture Local Visualforce Evidence",
        "view": "preview",
        "contexts": [
          "project",
          "vfServerRunning"
        ],
        "command": [
          "visualforce",
          "capture"
        ],
        "args": [
          "--local",
          "--glade-bin",
          "glade",
          "--project",
          "${projectRoot}",
          "--out",
          "${outputDir}/visualforce-local.json",
          "--json",
          "--editor-findings"
        ],
        "output": "glade.findings.v1",
        "icon": "record"
      },
      {
        "id": "compat.lwcCapture",
        "title": "Capture LWC Browser Evidence",
        "view": "preview",
        "contexts": [
          "project",
          "lwcServerRunning"
        ],
        "command": [
          "compat",
          "lwc",
          "capture"
        ],
        "inputs": [
          {
            "name": "targetOrg",
            "label": "Target org alias",
            "type": "text",
            "required": true
          },
          {
            "name": "localBaseUrl",
            "label": "Local LWC shell URL",
            "type": "text",
            "required": true
          }
        ],
        "args": [
          "--target-org",
          "${input.targetOrg}",
          "--project",
          "${projectRoot}",
          "--local-browser-capture",
          "--local-base-url",
          "${input.localBaseUrl}",
          "--browser-capture",
          "--out",
          "${outputDir}/lwc-browser-capture.json",
          "--json",
          "--editor-findings"
        ],
        "output": "glade.findings.v1",
        "icon": "cloud-download"
      }
    ]
  },
  "minimumGladeVersion": "0.1.0",
  "source": "github.com/glade-sh/glade/tools"
}
