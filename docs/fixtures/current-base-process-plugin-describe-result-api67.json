      "content": "@isTest private class CurrentBaseProcessPluginDescribeResultTest { @isTest static void constructorsAndEnum() { Process.PluginDescribeResult.ParameterType parameterType = Process.PluginDescribeResult.ParameterType.STRING; System.assertEquals(parameterType, Process.PluginDescribeResult.ParameterType.valueOf('STRING')); System.assert(parameterType.equals(Process.PluginDescribeResult.ParameterType.STRING)); System.assertNotEquals(null, parameterType.hashCode()); System.assert(parameterType.ordinal() >= 0); System.assert(Process.PluginDescribeResult.ParameterType.values().size() > 0); Process.PluginDescribeResult.InputParameter inputShort = new Process.PluginDescribeResult.InputParameter('recordId', Process.PluginDescribeResult.ParameterType.ID, true); Process.PluginDescribeResult.InputParameter inputLong = new Process.PluginDescribeResult.InputParameter('amount', 'Amount', Process.PluginDescribeResult.ParameterType.DECIMAL, false); Process.PluginDescribeResult.OutputParameter outputShort = new Process.PluginDescribeResult.OutputParameter('message', Process.PluginDescribeResult.ParameterType.STRING); Process.PluginDescribeResult.OutputParameter outputLong = new Process.PluginDescribeResult.OutputParameter('done', 'Done', Process.PluginDescribeResult.ParameterType.BOOLEAN); System.assertEquals('recordId', inputShort.Name); System.assertEquals(true, inputShort.Required); System.assertEquals('amount', inputLong.Name); System.assertEquals('Amount', inputLong.Description); System.assertEquals('message', outputShort.Name); System.assertEquals('done', outputLong.Name); System.assertEquals('Done', outputLong.Description); } }",
