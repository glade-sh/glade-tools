  "source": [{"path":"grouped-narrow.apex","content":"Metadata.AnalyticsCloudComponentLayoutItem a = new Metadata.AnalyticsCloudComponentLayoutItem(); a.assetType = 'asset'; a.devName = 'dev'; a.error = 'error'; a.filter = 'filter'; a.height = 12; a.hideOnError = true; a.showHeader = true; a.showSharing = false; a.showTitle = true; a.width = 'wide'; System.assertEquals('asset', a.assetType); System.assertEquals('dev', a.devName); System.assertEquals('error', a.error); System.assertEquals('filter', a.filter); System.assertEquals(12, a.height); System.assertEquals(true, a.hideOnError); System.assertEquals(true, a.showHeader); System.assertEquals(false, a.showSharing); System.assertEquals(true, a.showTitle); System.assertEquals('wide', a.width); System.assertNotEquals(null, a.clone()); Metadata.Container c = new Metadata.Container(); c.height = 20; c.isContainerAutoSizeEnabled = true; c.region = 'left'; c.style = 'compact'; c.unit = 'px'; c.width = 30; List<Metadata.SidebarComponent> s = c.sidebarComponents; System.assertEquals(20, c.height); System.assertEquals(true, c.isContainerAutoSizeEnabled); System.assertEquals('left', c.region); System.assertEquals('compact', c.style); System.assertEquals('px', c.unit); System.assertEquals(30, c.width); System.assert(s == null || s.isEmpty()); System.assertNotEquals(null, c.clone()); Metadata.CustomConsoleComponents x = new Metadata.CustomConsoleComponents(); Metadata.PrimaryTabComponents p = x.primaryTabComponents; Metadata.SubtabComponents q = x.subtabComponents; System.assert(p == null || p.clone() != null); System.assert(q == null || q.clone() != null); System.assertNotEquals(null, x.clone()); System.debug('GLADE_METADATA_BATCH:pass');\n"}],
