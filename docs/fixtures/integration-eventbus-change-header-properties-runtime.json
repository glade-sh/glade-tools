  "command":{"kind":"exec","args":["eventbus.ChangeEventHeader header = new eventbus.ChangeEventHeader(); List<String> changed = new List<String>{'FieldA'}; List<String> diff = new List<String>{'FieldB'}; List<String> recordIds = new List<String>{'record-local-1'}; header.setChangedFields(changed); header.setChangeOrigin('local.fixture'); header.setChangeType('UPDATE'); header.setCommitNumber(42L); header.setCommitTimestamp(987654321L); header.setCommitUser('local-user'); header.setDiffFields(diff); header.setEntityName('LocalEntity'); header.setNulledFields(new List<String>{'FieldC'}); header.setRecordIds(recordIds); header.setSequenceNumber(7); header.setTransactionKey('transaction-local-1'); System.assertEquals(changed, header.changedfields); System.assertEquals('local.fixture', header.changeorigin); System.assertEquals('UPDATE', header.changetype); System.assertEquals(42L, header.commitnumber); System.assertEquals(987654321L, header.committimestamp); System.assertEquals('local-user', header.commituser); System.assertEquals(diff, header.difffields); System.assertEquals('LocalEntity', header.entityname); System.assertEquals(1, header.nulledfields.size()); System.assertEquals('FieldC', header.nulledfields[0]); System.assertEquals(recordIds, header.recordids); System.assertEquals(7, header.sequencenumber); System.assertEquals('transaction-local-1', header.transactionkey);"]},
